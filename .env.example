# Copiar a .env.local (desarrollo) o configurar en Vercel → Settings → Environment Variables

# URL pública del sitio (dominio final). Si se omite, en Vercel se usa el dominio de producción del proyecto.
# NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# Correo corporativo visible en la web (opcional: si se deja vacío no se muestra)
NEXT_PUBLIC_CONTACT_EMAIL=

# SMTP del correo corporativo (cPanel → Cuentas de correo → Conectar dispositivos)
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ventas@tudominio.com
SMTP_PASS=

# Destinatario(s) de los formularios (separados por coma). Por defecto: SMTP_USER
MAIL_TO=
# Remitente. Por defecto: "D'Cora Hogar Web" <SMTP_USER>
MAIL_FROM=
# Enviar respuesta automática de confirmación al cliente (true/false)
MAIL_AUTOREPLY=false

# Libro de Reclamaciones
# Correo que recibe las hojas de reclamación (por defecto MAIL_TO o SMTP_USER)
RECLAMOS_TO=
# Datos fiscales del proveedor (ya vienen por defecto en src/data/site.ts)
# NEXT_PUBLIC_RUC=20603899572
# NEXT_PUBLIC_FISCAL_ADDRESS=Av. Coronel José Leal N.° 282, Lince, Lima, Perú
# Numeración correlativa (000000001-2026…): conectar Upstash Redis desde Vercel Marketplace
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Solo para pruebas: simula el envío sin SMTP en producción
# MAIL_DRY_RUN=true
# Límite de envíos por IP cada 10 minutos (por defecto 6)
# RATE_LIMIT_MAX=6
